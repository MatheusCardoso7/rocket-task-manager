{
  "compilerOptions": {
    "types": ["node", "jest"],
    "target": "ESNext",
    "lib": ["ESNext"],

    "module": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "paths": {
      "@/*": ["./src/*"]
    },

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/tests copy/sessions-controller.test", "src/tests copy/tasks-controller.test"],
  "exclude": ["node_modules", "dist"]
}
